# Password that unlocks live search. Without it, everyone sees sample data.
SCOUT_PASSWORD=

# YouTube Data API v3 key (Google Cloud console -> APIs & Services -> Credentials)
YOUTUBE_API_KEY=

# Apify API token (console.apify.com -> Settings -> API & Integrations)
APIFY_TOKEN=

# Optional: spend cap per Apify run, in USD (default 0.50)
APIFY_MAX_CHARGE_USD=0.5
# Optional: override actors
APIFY_TIKTOK_ACTOR=clockworks~tiktok-scraper
APIFY_INSTAGRAM_ACTOR=apify~instagram-scraper
APIFY_INSTAGRAM_SEARCH_TYPE=user
